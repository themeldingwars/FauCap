<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Authors>freakbyte</Authors>
    <Company>TheMeldingWars</Company>
    <RepositoryUrl>https://github.com/themeldingwars/FauCap</RepositoryUrl>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Product>FauCap</Product>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="SharpPcap" Version="6.3.1" />
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  
  <ItemGroup>
    <ProjectReference Include="..\FauCapParser\FauCapParser.csproj" />
  </ItemGroup>

</Project>
